{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/CanopyX/main/docs/schema/canopyx-view-state-1.schema.json",
  "title": "CanopyX view intent, version 1",
  "description": "A data-only proposal for a grid's query and ordered visible columns. Preview before explicit apply. Missing query fields preserve accepted values; empty arrays clear the corresponding setting; filterGroup:null clears grouped predicates. Column identities and capabilities, shared predicate/group counts, and group depth require target-aware validation. No data, model request, endpoint, action, authorization or executable code is included.",
  "type": "object",
  "required": ["protocol", "type", "version", "view"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "canopyx/2" },
    "type": { "const": "viewIntent" },
    "version": { "const": 1 },
    "view": { "$ref": "#/$defs/identifier" },
    "query": { "$ref": "#/$defs/query" },
    "columns": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
  },
  "anyOf": [
    { "required": ["columns"] },
    { "required": ["query"], "properties": { "query": { "minProperties": 1 } } }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1 },
    "scalar": { "oneOf": [
      { "type": "string", "maxLength": 16384 },
      { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 },
      { "type": "boolean" }
    ] },
    "sort": {
      "type": "object", "required": ["column", "direction"], "additionalProperties": false,
      "properties": { "column": { "$ref": "#/$defs/identifier" }, "direction": { "enum": ["asc", "desc"] } }
    },
    "groupLevel": {
      "type": "object", "required": ["column", "direction"], "additionalProperties": false,
      "properties": { "column": { "$ref": "#/$defs/identifier" }, "direction": { "enum": ["asc", "desc"] }, "aggregate": { "$ref": "#/$defs/identifier" } }
    },
    "filter": {
      "type": "object", "required": ["column", "operator", "values"], "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "ne", "contains", "startsWith", "in", "gt", "ge", "lt", "le", "isNull", "isNotNull"] },
        "values": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/scalar" } }
      },
      "oneOf": [
        { "properties": { "operator": { "enum": ["isNull", "isNotNull"] }, "values": { "maxItems": 0 } } },
        { "properties": { "operator": { "const": "in" }, "values": { "minItems": 1 } } },
        { "properties": { "operator": { "enum": ["eq", "ne", "contains", "startsWith", "gt", "ge", "lt", "le"] }, "values": { "minItems": 1, "maxItems": 1 } } }
      ]
    },
    "filterGroup": {
      "type": "object", "required": ["operator", "filters", "groups"], "additionalProperties": false,
      "properties": {
        "operator": { "enum": ["and", "or"] },
        "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/filter" } },
        "groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/filterGroup" } }
      },
      "anyOf": [ { "properties": { "filters": { "minItems": 1 } } }, { "properties": { "groups": { "minItems": 1 } } } ]
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "search": { "type": "string", "maxLength": 16384 },
        "searchMode": { "enum": ["substring", "words"] },
        "sort": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/sort" } },
        "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/filter" } },
        "filterGroup": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/filterGroup" } ] },
        "groupBy": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/groupLevel" } }
      }
    }
  }
}
