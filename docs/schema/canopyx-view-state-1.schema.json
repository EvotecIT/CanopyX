{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/CanopyX/main/docs/schema/canopyx-view-state-1.schema.json",
  "title": "CanopyX view intent, version 1",
  "description": "A data-only proposal for a grid's query, ordered visible columns and optional pivot definition. Preview before explicit apply. Missing query fields preserve accepted values; empty arrays clear the corresponding setting; filterGroup:null clears grouped predicates. Column identities and capabilities, shared predicate/group counts, and group depth require target-aware validation. No data, model request, endpoint, action, authorization or executable code is included.",
  "type": "object",
  "required": [
    "protocol",
    "type",
    "version",
    "view"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "canopyx/2"
    },
    "type": {
      "const": "viewIntent"
    },
    "version": {
      "const": 1
    },
    "view": {
      "$ref": "#/$defs/identifier"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "pivot": {
      "oneOf": [
        {
          "const": false
        },
        {
          "$ref": "#/$defs/pivot"
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "columns"
      ]
    },
    {
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "minProperties": 1
        }
      }
    },
    {
      "required": [
        "pivot"
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        }
      ]
    },
    "sort": {
      "type": "object",
      "required": [
        "column",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "groupLevel": {
      "type": "object",
      "required": [
        "column",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "aggregate": {
          "$ref": "#/$defs/identifier"
        },
        "bucket": {
          "$ref": "#/$defs/bucket"
        }
      }
    },
    "filter": {
      "type": "object",
      "required": [
        "column",
        "operator",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "contains",
            "startsWith",
            "in",
            "gt",
            "ge",
            "lt",
            "le",
            "isNull",
            "isNotNull"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "bucket": {
          "$ref": "#/$defs/bucket"
        }
      },
      "oneOf": [
        {
          "properties": {
            "operator": {
              "enum": [
                "isNull",
                "isNotNull"
              ]
            },
            "values": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "operator": {
              "const": "in"
            },
            "values": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "ne",
                "contains",
                "startsWith",
                "gt",
                "ge",
                "lt",
                "le"
              ]
            },
            "values": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "filterGroup": {
      "type": "object",
      "required": [
        "operator",
        "filters",
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "and",
            "or"
          ]
        },
        "filters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/filterGroup"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "filters": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "groups": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {
          "type": "string",
          "maxLength": 16384
        },
        "searchMode": {
          "enum": [
            "substring",
            "words"
          ]
        },
        "sort": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "filterGroup": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/filterGroup"
            }
          ]
        },
        "groupBy": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/groupLevel"
          }
        },
        "tupleFilters": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/tupleFilter"
          }
        }
      }
    },
    "bucket": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year",
                "hour",
                "weekday"
              ]
            },
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "firstWeekday": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "width"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "width"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "origin": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "edges"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "edges"
            },
            "edges": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "pivotLevel": {
      "type": "object",
      "required": [
        "column",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "bucket": {
          "$ref": "#/$defs/bucket"
        }
      }
    },
    "pivot": {
      "type": "object",
      "required": [
        "rows",
        "columns",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/pivotLevel"
          }
        },
        "columns": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/pivotLevel"
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "maxColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "topNColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "sortByTotal": {
          "type": "object",
          "required": [
            "aggregate",
            "direction"
          ],
          "additionalProperties": false,
          "properties": {
            "aggregate": {
              "$ref": "#/$defs/identifier"
            },
            "direction": {
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        }
      }
    },
    "tupleColumn": {
      "description": "One raw or bucketed column of an exact correlated tuple.",
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "bucket": {
          "$ref": "#/$defs/bucket"
        }
      }
    },
    "tupleFilter": {
      "description": "Atomic exact membership of correlated column values; exclusion complements membership including null. Readers validate operand kinds against declared columns. Strings are exact and dates compare by instant.",
      "type": "object",
      "required": [
        "columns",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/tupleColumn"
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/nullableScalar"
            }
          }
        },
        "exclude": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 5,
                  "maxItems": 5
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "columns": {
                "minItems": 6,
                "maxItems": 6
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "items": {
                  "minItems": 6,
                  "maxItems": 6
                }
              }
            }
          }
        }
      ]
    },
    "nullableScalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/scalar"
        }
      ]
    }
  }
}
