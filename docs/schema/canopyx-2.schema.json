{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/CanopyX/main/docs/schema/canopyx-2.schema.json",
  "title": "CanopyX data protocol, version 2 (canopyx/2)",
  "description": "Every canopyx/2 document. The schema lists every field of the current revision and rejects unknown ones, so it doubles as a writer check. Readers must ignore unknown fields so documents from a newer canopyx/2 writer still load.",
  "oneOf": [
    { "$ref": "#/$defs/view" },
    { "$ref": "#/$defs/grid" },
    { "$ref": "#/$defs/gridPage" },
    { "$ref": "#/$defs/gridQuery" },
    { "$ref": "#/$defs/gridCursorPage" },
    { "$ref": "#/$defs/gridCursorQuery" },
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/search" },
    { "$ref": "#/$defs/counts" },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/pack" },
    { "$ref": "#/$defs/searchShard" },
    { "$ref": "#/$defs/searchEntries" }
  ],
  "$defs": {
    "protocol": { "const": "canopyx/2" },
    "gridRow": {
      "description": "A flat row with a dataset-stable identity. Writers and readers also enforce unique identities across the dataset.",
      "type": "object",
      "required": ["id", "cells"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "cells": { "type": "object", "propertyNames": { "$ref": "#/$defs/identifier" }, "additionalProperties": { "$ref": "#/$defs/cell" } }
      }
    },
    "grid": {
      "description": "A flat data-grid definition. All columns contain cells; none represents hierarchy.",
      "type": "object",
      "required": ["protocol", "type", "id", "label", "rowHeight", "pageSize", "selection", "search", "columns", "source"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "grid" },
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/accessibleLabel" },
        "rowHeight": { "type": "integer", "minimum": 20, "maximum": 64 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "selection": { "enum": ["single", "multiple"] },
        "search": { "type": "boolean" },
        "presentation": { "enum": ["continuous", "paged"] },
        "pageLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "searchDelayMs": { "type": "integer", "minimum": 0, "maximum": 5000, "description": "Search-input debounce; absent uses zero for inline sources and 300 for hosted sources. Enter applies immediately." },
        "searchColumns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" }, "$comment": "Every identity must bind to a declared grid column; absent searches every declared column." },
        "reporting": { "$ref": "#/$defs/gridReporting" },
        "columns": {
          "type": "array", "minItems": 1,
          "items": { "allOf": [{ "$ref": "#/$defs/column" }, { "properties": { "editable": { "const": false } } }] },
          "contains": { "not": { "required": ["hidden"], "properties": { "hidden": { "const": true } } } }
        },
        "source": { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "enum": ["inline", "host"] }, "navigation": { "enum": ["offset", "cursor"], "description": "Known-count offset access or paged host cursor traversal. Absent preserves offset access." } } },
        "stateKey": { "type": "string" },
        "timeZone": { "enum": ["utc", "local"] },
        "labels": { "$ref": "#/$defs/view/properties/labels" },
        "query": { "oneOf": [{ "$ref": "#/$defs/gridQuery" }, { "$ref": "#/$defs/gridCursorQuery" }] },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/gridRow" } }
      },
      "if": { "properties": { "source": { "properties": { "kind": { "const": "inline" } } } } },
      "then": { "required": ["rows"] },
      "else": { "not": { "required": ["rows"] } },
      "allOf": [{
        "if": { "properties": { "source": { "required": ["navigation"], "properties": { "navigation": { "const": "cursor" } } } } },
        "then": { "required": ["presentation"], "properties": { "presentation": { "const": "paged" }, "source": { "properties": { "kind": { "const": "host" } } }, "query": { "$ref": "#/$defs/gridCursorQuery" } } },
        "else": { "properties": { "query": { "$ref": "#/$defs/gridQuery" } } }
      }]
    },
    "gridReporting": {
      "type": "object", "additionalProperties": false,
      "description": "Optional capabilities requiring the reporting entry point. Policies bind to declared sortable text columns.",
      "properties": {
        "ordering": { "type": "object", "additionalProperties": { "$ref": "#/$defs/gridOrdering" } },
        "headerFilters": { "type": "boolean" }
      }
    },
    "gridOrdering": {
      "type": "object", "required": ["text"], "additionalProperties": false,
      "properties": {
        "text": { "enum": ["ordinal", "foldedOrdinal", "natural", "foldedNatural"] },
        "categories": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "type": "string", "maxLength": 4096 },
          "$comment": "Writers and readers also reject category collisions after the selected frozen case folding." }
      }
    },
    "gridPage": {
      "description": "A page after full-dataset filtering and sorting. Writers and readers check offset <= matched <= total, page bounds, and unique row identities.",
      "type": "object",
      "required": ["protocol", "type", "view", "revision", "offset", "total", "matched", "items"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "gridPage" },
        "view": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/identifier" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "total": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/gridRow" } }
      }
    },
    "gridQuery": {
      "description": "Search, AND-combined flat predicates and the optional nested filter group precede ordered sorting and paging. Missing values sort last; row identity breaks final ties.",
      "type": "object",
      "required": ["protocol", "type", "view", "offset", "limit", "search", "sort", "filters"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "gridQuery" },
        "view": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/identifier" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "search": { "type": "string" },
        "searchMode": { "enum": ["substring", "words"], "default": "substring" },
        "filterGroup": { "$ref": "#/$defs/gridFilterGroup" },
        "sort": {
          "type": "array",
          "items": { "type": "object", "required": ["column", "direction"], "additionalProperties": false, "properties": {
            "column": { "$ref": "#/$defs/identifier" }, "direction": { "enum": ["asc", "desc"] }
          } }
        },
        "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gridFilter" } }
      }
    },
    "gridCursorPage": {
      "description": "A complete visible page reached through opaque host cursors. Offset is the actual ordinal position; unknown counts are null. Readers enforce contiguous navigation, consistent revisions/counts, page bounds and unique identities.",
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type", "view", "revision", "offset", "total", "matched", "items"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" }, "type": { "const": "gridCursorPage" },
        "view": { "$ref": "#/$defs/identifier" }, "revision": { "$ref": "#/$defs/identifier" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "total": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
        "matched": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 },
        "nextCursor": { "$ref": "#/$defs/gridCursor" }, "previousCursor": { "$ref": "#/$defs/gridCursor" },
        "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/gridRow" } }
      }
    },
    "gridCursor": { "type": "string", "minLength": 1, "maxLength": 4096, "$comment": "Runtime and writer enforce the limit in UTF-16 code units and reject malformed Unicode." },
    "gridCursorQuery": {
      "description": "The same full-dataset query criteria as gridQuery, traversed through an optional opaque cursor; no random-access offset is sent.",
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type", "view", "limit", "search", "sort", "filters"],
      "dependentRequired": { "cursor": ["revision"] },
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" }, "type": { "const": "gridCursorQuery" },
        "view": { "$ref": "#/$defs/identifier" }, "revision": { "$ref": "#/$defs/identifier" },
        "cursor": { "$ref": "#/$defs/gridCursor" },
        "limit": { "$ref": "#/$defs/gridQuery/properties/limit" },
        "search": { "$ref": "#/$defs/gridQuery/properties/search" },
        "searchMode": { "$ref": "#/$defs/gridQuery/properties/searchMode" },
        "sort": { "$ref": "#/$defs/gridQuery/properties/sort" },
        "filters": { "$ref": "#/$defs/gridQuery/properties/filters" },
        "filterGroup": { "$ref": "#/$defs/gridQuery/properties/filterGroup" }
      }
    },
    "gridFilterGroup": {
      "description": "A nonempty AND/OR group. Readers enforce eight levels, 64 groups and 64 predicates total, including flat query predicates.",
      "type": "object",
      "required": ["operator", "filters", "groups"],
      "additionalProperties": false,
      "properties": {
        "operator": { "enum": ["and", "or"] },
        "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gridFilter" } },
        "groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gridFilterGroup" } }
      },
      "anyOf": [{ "properties": { "filters": { "minItems": 1 } } }, { "properties": { "groups": { "minItems": 1 } } }]
    },
    "gridFilter": {
      "type": "object",
      "required": ["column", "operator", "values"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "ne", "contains", "startsWith", "in", "gt", "ge", "lt", "le", "isNull", "isNotNull"] },
        "values": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/cellValue" }, { "not": { "type": "null" } }] } }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["isNull", "isNotNull"] } } },
          "then": { "properties": { "values": { "maxItems": 0 } } },
          "else": {
            "if": { "properties": { "operator": { "const": "in" } } },
            "then": { "properties": { "values": { "minItems": 1, "maxItems": 1000 } } },
            "else": { "properties": { "values": { "minItems": 1, "maxItems": 1 } } }
          }
        }
      ]
    },
    "accessibleLabel": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1, "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$" },
    "tone": { "description": "neutral, info, success, warning, danger, muted, or a tone the host theme defines.", "type": "string", "pattern": "^(?!.*-bg$)[a-z][a-z0-9-]{0,31}$" },
    "badge": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "tone": { "$ref": "#/$defs/tone" },
        "title": { "type": "string" }
      }
    },
    "cellValue": { "type": ["string", "number", "boolean", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "cell": {
      "description": "A bare value, or an object with a value plus display text, tooltip, tone, and badges.",
      "oneOf": [
        { "$ref": "#/$defs/cellValue" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "$ref": "#/$defs/cellValue" },
            "text": { "type": "string" },
            "searchText": { "type": "string", "description": "Alternate flat-grid search text; it does not change display, sort, filter or export values." },
            "title": { "type": "string" },
            "tone": { "$ref": "#/$defs/tone" },
            "badges": { "type": "array", "items": { "$ref": "#/$defs/badge" } }
          }
        }
      ]
    },
    "cells": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
      "additionalProperties": { "$ref": "#/$defs/cell" }
    },
    "detail": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["table", "properties", "html"] },
        "height": { "description": "Row slots the detail row spans; without it the row is as tall as its content.", "type": "integer", "minimum": 1, "maximum": 40 }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "table" },
            "height": true,
            "caption": { "type": "string" },
            "columns": { "type": "array", "items": { "type": "string" } },
            "widths": { "description": "Column widths as shares of the table width, one per column.", "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 1000 } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } } }
          },
          "required": ["columns", "rows"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "properties" },
            "height": true,
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "additionalProperties": false,
                "properties": {
                  "name": { "$ref": "#/$defs/nonEmptyString" },
                  "value": { "$ref": "#/$defs/cell" }
                }
              }
            }
          },
          "required": ["items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "html" },
            "height": true,
            "html": { "type": "string" }
          },
          "required": ["html"],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string" },
        "kind": { "type": "string" },
        "icon": { "type": "string" },
        "group": { "type": "boolean" },
        "cells": { "$ref": "#/$defs/cells" },
        "badges": { "type": "array", "items": { "$ref": "#/$defs/badge" } },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "data": { "description": "Host facts handed to host callbacks; not shown and not searched.", "type": "object", "propertyNames": { "type": "string", "minLength": 1, "not": { "const": "__proto__" } }, "additionalProperties": { "type": "string" } },
        "hasChildren": { "type": "boolean" },
        "childCount": { "type": "integer", "minimum": 1, "maximum": 2147483647, "$comment": "When children is present, readers require this value to equal its length; this cross-field equality is a semantic protocol constraint." },
        "ref": { "$ref": "#/$defs/identifier" },
        "expanded": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/detail" },
        "className": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "allOf": [{ "not": { "required": ["ref", "children"] } }, {
        "if": { "anyOf": [{ "required": ["childCount"] }, { "required": ["ref"] }] },
        "then": { "anyOf": [
          { "required": ["children"], "properties": { "children": { "minItems": 1 } } },
          { "required": ["hasChildren"], "properties": { "hasChildren": { "const": true } } }
        ] }
      }, {
        "if": { "required": ["hasChildren", "children"], "properties": { "hasChildren": { "const": true } } },
        "then": { "properties": { "children": { "minItems": 1 } } }
      }, {
        "if": { "required": ["children"], "properties": { "children": { "minItems": 1 } } },
        "then": { "properties": { "hasChildren": { "const": true } } }
      }],
      "not": {
        "required": ["detail"],
        "anyOf": [
          { "required": ["children"] },
          { "required": ["hasChildren"], "properties": { "hasChildren": { "const": true } } }
        ]
      }
    },
    "inlineNode": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "not": { "required": ["ref"] },
          "properties": { "children": { "items": { "$ref": "#/$defs/inlineNode" } } },
          "if": { "required": ["hasChildren"], "properties": { "hasChildren": { "const": true } } },
          "then": { "required": ["children"], "properties": { "children": { "minItems": 1 } } }
        }
      ]
    },
    "column": {
      "type": "object",
      "required": ["id", "title", "width", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/accessibleLabel" },
        "width": { "type": "integer", "minimum": 40, "maximum": 2147483647 },
        "kind": { "enum": ["text", "number", "datetime"] },
        "sortable": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": { "kind": { "const": "inline" } },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "sidecar" },
            "base": { "type": "string", "pattern": "^[^?#]*/$" }
          },
          "required": ["base"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "remote" },
            "queryAware": { "description": "The host applies the view query before paging; every page carries a dataset revision.", "type": "boolean" },
            "children": { "type": "string", "pattern": "^[^#]*\\{ref\\}[^#]*\\{cursor\\}|^[^#]*\\{cursor\\}[^#]*\\{ref\\}" },
            "search": { "type": "string", "pattern": "^[^#]*\\{query\\}[^#]*\\{limit\\}|^[^#]*\\{limit\\}[^#]*\\{query\\}" },
            "counts": { "type": "string", "pattern": "^[^#]*\\{ids\\}" }
          },
          "required": ["children"],
          "if": { "required": ["queryAware"], "properties": { "queryAware": { "const": true } } },
          "then": { "properties": {
            "children": { "pattern": "^[^#]*\\{viewQuery\\}" },
            "search": { "pattern": "^[^#]*\\{viewQuery\\}" },
            "counts": { "pattern": "^[^#]*\\{viewQuery\\}" }
          } },
          "additionalProperties": false
        }
      ]
    },
    "filter": {
      "type": "object",
      "required": ["id", "label", "flag"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/accessibleLabel" },
        "flag": { "$ref": "#/$defs/nonEmptyString" },
        "ancestorFlag": { "$ref": "#/$defs/nonEmptyString" },
        "hidden": { "description": "The toolbar draws no switch; the host controls the filter.", "type": "boolean" }
      }
    },
    "searchHit": {
      "type": "object",
      "required": ["path", "label"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "label": { "type": "string" },
        "kind": { "type": "string" },
        "context": { "type": "string" }
      }
    },
    "view": {
      "type": "object",
      "required": ["protocol", "type", "id", "label", "rowHeight", "pageSize", "selection", "columns", "source"],
      "additionalProperties": false,
      "dependentRequired": { "checkIntents": ["checkboxes"] },
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "view" },
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/accessibleLabel" },
        "rowHeight": { "type": "integer", "minimum": 20, "maximum": 64 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "selection": { "enum": ["single", "multiple"] },
        "dragDrop": { "description": "Offers proposals to a host drop hook; the runtime never moves nodes itself.", "type": "boolean" },
        "contextActions": {
          "type": "array", "items": {
            "type": "object", "required": ["id", "label"], "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/identifier" }, "label": { "$ref": "#/$defs/accessibleLabel" } }
          }
        },
        "checkboxes": { "description": "Checking is independent of row selection; hierarchical rules include unloaded descendants.", "enum": ["independent", "hierarchical"] },
        "checkIntents": {
          "type": "array",
          "uniqueItems": true,
          "$comment": "Writers and readers also require unique paths when checked values differ; JSON Schema uniqueItems compares complete items.",
          "items": {
            "type": "object", "required": ["path", "checked"], "additionalProperties": false,
            "properties": {
              "path": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
              "checked": { "type": "boolean" }
            }
          }
        },
        "columns": { "type": "array", "minItems": 1, "prefixItems": [{ "allOf": [{ "$ref": "#/$defs/column" }, { "properties": { "hidden": { "const": false } } }] }], "items": { "$ref": "#/$defs/column" } },
        "icons": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "string", "pattern": "^\\s*<[sS][vV][gG][ \\t\\r\\n\\f/>]" } },
        "search": {
          "type": "object",
          "required": ["minLength", "maxResults"],
          "additionalProperties": false,
          "properties": {
            "minLength": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maxResults": { "type": "integer", "minimum": 1, "maximum": 500 },
            "placeholder": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "kinds": { "description": "The node kinds search can find; every node when absent.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
          }
        },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "timeZone": { "description": "The time zone datetime columns show at first; utc when absent.", "enum": ["utc", "local"] },
        "pinTreeColumn": { "description": "The tree column stays in view while the other columns scroll sideways.", "type": "boolean" },
        "stateKey": { "type": "string" },
        "deepLink": { "type": "boolean" },
        "labels": {
          "description": "Translations of the texts the runtime writes itself; English where a name is absent. {placeholders} are replaced.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "searchPlaceholder": { "$ref": "#/$defs/accessibleLabel" },
            "searchResults": { "$ref": "#/$defs/accessibleLabel" },
            "searchResultCount": { "$ref": "#/$defs/accessibleLabel" },
            "searchResultCountOfTotal": { "$ref": "#/$defs/accessibleLabel" },
            "searchResultCountOfMany": { "$ref": "#/$defs/accessibleLabel" },
            "searchNoResults": { "$ref": "#/$defs/accessibleLabel" },
            "searchTooShort": { "$ref": "#/$defs/accessibleLabel" },
            "searchWordTooShort": { "$ref": "#/$defs/accessibleLabel" },
            "searchFailed": { "$ref": "#/$defs/accessibleLabel" },
            "columns": { "$ref": "#/$defs/accessibleLabel" },
            "gridFilters": { "$ref": "#/$defs/accessibleLabel" },
            "gridPaging": { "$ref": "#/$defs/accessibleLabel" },
            "gridPageRange": { "$ref": "#/$defs/accessibleLabel" },
            "gridPageNumber": { "$ref": "#/$defs/accessibleLabel" },
            "gridPageLength": { "$ref": "#/$defs/accessibleLabel" },
            "gridFirstPage": { "$ref": "#/$defs/accessibleLabel" },
            "gridPreviousPage": { "$ref": "#/$defs/accessibleLabel" },
            "gridNextPage": { "$ref": "#/$defs/accessibleLabel" },
            "gridLastPage": { "$ref": "#/$defs/accessibleLabel" },
            "gridResultCount": { "$ref": "#/$defs/accessibleLabel" },
            "gridUnknownCount": { "$ref": "#/$defs/accessibleLabel" },
            "gridMatchedCount": { "$ref": "#/$defs/accessibleLabel" },
            "gridCursorRange": { "$ref": "#/$defs/accessibleLabel" },
            "gridClearQuery": { "$ref": "#/$defs/accessibleLabel" },
            "gridRemoveSearch": { "$ref": "#/$defs/accessibleLabel" },
            "gridGroupedFilters": { "$ref": "#/$defs/accessibleLabel" },
            "gridRemoveGroup": { "$ref": "#/$defs/accessibleLabel" },
            "gridRemoveCondition": { "$ref": "#/$defs/accessibleLabel" },
            "gridExport": { "$ref": "#/$defs/accessibleLabel" },
            "gridFilteredResults": { "$ref": "#/$defs/accessibleLabel" },
            "gridSelectedRows": { "$ref": "#/$defs/accessibleLabel" },
            "gridAllResults": { "$ref": "#/$defs/accessibleLabel" },
            "gridDownloadCsv": { "$ref": "#/$defs/accessibleLabel" },
            "gridCopy": { "$ref": "#/$defs/accessibleLabel" },
            "gridDetails": { "$ref": "#/$defs/accessibleLabel" },
            "gridColumn": { "$ref": "#/$defs/accessibleLabel" },
            "gridOperator": { "$ref": "#/$defs/accessibleLabel" },
            "gridValue": { "$ref": "#/$defs/accessibleLabel" },
            "gridValueType": { "$ref": "#/$defs/accessibleLabel" },
            "gridText": { "$ref": "#/$defs/accessibleLabel" },
            "gridBoolean": { "$ref": "#/$defs/accessibleLabel" },
            "gridAddFilter": { "$ref": "#/$defs/accessibleLabel" },
            "gridRemoveFilter": { "$ref": "#/$defs/accessibleLabel" },
            "gridApply": { "$ref": "#/$defs/accessibleLabel" },
            "gridClearFilters": { "$ref": "#/$defs/accessibleLabel" },
            "gridMoveEarlier": { "$ref": "#/$defs/accessibleLabel" },
            "gridMoveLater": { "$ref": "#/$defs/accessibleLabel" },
            "gridViews": { "$ref": "#/$defs/accessibleLabel" },
            "gridViewName": { "$ref": "#/$defs/accessibleLabel" },
            "gridSaveView": { "$ref": "#/$defs/accessibleLabel" },
            "gridRemoveView": { "$ref": "#/$defs/accessibleLabel" },
            "gridResetView": { "$ref": "#/$defs/accessibleLabel" },
            "gridChooseView": { "$ref": "#/$defs/accessibleLabel" },
            "gridInvalidFilter": { "$ref": "#/$defs/accessibleLabel" },
            "gridContains": { "$ref": "#/$defs/accessibleLabel" },
            "gridStartsWith": { "$ref": "#/$defs/accessibleLabel" },
            "gridIn": { "$ref": "#/$defs/accessibleLabel" },
            "gridIsNull": { "$ref": "#/$defs/accessibleLabel" },
            "gridIsNotNull": { "$ref": "#/$defs/accessibleLabel" },
            "gridBetween": { "$ref": "#/$defs/accessibleLabel" },
            "gridRangeEnd": { "$ref": "#/$defs/accessibleLabel" },
            "gridInvalidRange": { "$ref": "#/$defs/accessibleLabel" },
            "gridSuggestedCategory": { "$ref": "#/$defs/accessibleLabel" },
            "gridChooseCategory": { "$ref": "#/$defs/accessibleLabel" },
            "gridBooleanValue": { "$ref": "#/$defs/accessibleLabel" },
            "gridTrue": { "$ref": "#/$defs/accessibleLabel" },
            "gridFalse": { "$ref": "#/$defs/accessibleLabel" },
            "gridHeaderFilter": { "$ref": "#/$defs/accessibleLabel" },
            "visibleColumns": { "$ref": "#/$defs/accessibleLabel" },
            "resizeColumn": { "$ref": "#/$defs/accessibleLabel" },
            "columnWidth": { "$ref": "#/$defs/accessibleLabel" },
            "loading": { "$ref": "#/$defs/accessibleLabel" },
            "loadError": { "$ref": "#/$defs/accessibleLabel" },
            "queryFailed": { "$ref": "#/$defs/accessibleLabel" },
            "actions": { "$ref": "#/$defs/accessibleLabel" },
            "editValue": { "$ref": "#/$defs/accessibleLabel" },
            "saveEdit": { "$ref": "#/$defs/accessibleLabel" },
            "cancelEdit": { "$ref": "#/$defs/accessibleLabel" },
            "invalidEdit": { "$ref": "#/$defs/accessibleLabel" },
            "interactionPending": { "$ref": "#/$defs/accessibleLabel" },
            "interactionRejected": { "$ref": "#/$defs/accessibleLabel" },
            "interactionFailed": { "$ref": "#/$defs/accessibleLabel" },
            "markMove": { "$ref": "#/$defs/accessibleLabel" },
            "moveHere": { "$ref": "#/$defs/accessibleLabel" },
            "moveBefore": { "$ref": "#/$defs/accessibleLabel" },
            "moveAfter": { "$ref": "#/$defs/accessibleLabel" },
            "cancelMove": { "$ref": "#/$defs/accessibleLabel" },
            "showMore": { "$ref": "#/$defs/accessibleLabel" },
            "showMoreUnknownTotal": { "$ref": "#/$defs/accessibleLabel" },
            "pageLoaded": { "$ref": "#/$defs/accessibleLabel" },
            "itemsLoaded": { "$ref": "#/$defs/accessibleLabel" },
            "yes": { "$ref": "#/$defs/accessibleLabel" },
            "no": { "$ref": "#/$defs/accessibleLabel" },
            "utcTime": { "type": "string", "pattern": "\\{time\\}" },
            "localTime": { "type": "string", "pattern": "\\{time\\}" },
            "mountError": { "$ref": "#/$defs/accessibleLabel" }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "roots": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "if": { "properties": { "source": { "properties": { "kind": { "const": "inline" } } } } },
      "then": { "required": ["roots"], "properties": { "roots": { "items": { "$ref": "#/$defs/inlineNode" } } } },
      "else": { "not": { "required": ["roots"] } },
      "allOf": [{
        "if": { "properties": { "source": { "properties": { "kind": { "const": "sidecar" } } } } },
        "then": { "properties": { "search": { "properties": { "minLength": { "minimum": 2 } } } } }
      }, {
        "if": { "required": ["search"], "properties": { "source": { "properties": { "kind": { "const": "remote" } } } } },
        "then": { "properties": { "source": { "required": ["search"] } } }
      }]
    },
    "viewQuery": {
      "description": "JSON carried in the viewQuery URL parameter; it is not a document envelope.",
      "type": "object",
      "required": ["version", "sort", "filters"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "sort": { "oneOf": [ { "type": "null" }, {
          "type": "object", "required": ["column", "direction"], "additionalProperties": false,
          "properties": { "column": { "$ref": "#/$defs/identifier" }, "direction": { "enum": ["asc", "desc"] } }
        } ] },
        "filters": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "page": {
      "type": "object",
      "required": ["protocol", "type", "parent", "offset", "items", "next"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "page" },
        "revision": { "$ref": "#/$defs/identifier" },
        "parent": { "type": ["string", "null"], "minLength": 1, "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "total": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "next": { "type": ["string", "null"], "minLength": 1, "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$" }
      }
    },
    "search": {
      "type": "object",
      "required": ["protocol", "type", "query", "truncated", "hits"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "search" },
        "revision": { "$ref": "#/$defs/identifier" },
        "query": { "type": "string" },
        "total": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "truncated": { "type": "boolean" },
        "hits": { "type": "array", "items": { "$ref": "#/$defs/searchHit" } }
      }
    },
    "counts": {
      "type": "object",
      "$comment": "Counts item ids are unique within a document; writers and readers enforce this semantic constraint.",
      "required": ["protocol", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "counts" },
        "revision": { "$ref": "#/$defs/identifier" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "childCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
              "cells": { "$ref": "#/$defs/cells" },
              "flags": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["protocol", "type", "view", "root", "nodeCount", "pageSize"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "manifest" },
        "view": { "$ref": "#/$defs/identifier" },
        "root": { "$ref": "#/$defs/identifier" },
        "nodeCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "packs": { "description": "The number of p/<n> pack files. When present, a reference p/<n>#<slot> names page <slot> of pack <n>.", "$ref": "#/$defs/count" },
        "search": {
          "type": "object",
          "required": ["entryCount", "entryFiles", "kinds", "shards"],
          "additionalProperties": false,
          "properties": {
            "entryCount": { "$ref": "#/$defs/count" },
            "entryFiles": {
              "description": "The number of the first entry in each e/<n> file, in file order.",
              "type": "array",
              "items": { "$ref": "#/$defs/count" }
            },
            "kinds": { "type": "array", "items": { "type": "string" } },
            "shards": {
              "description": "Each shard file's key and the number of entries its posting lists refer to.",
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/shardKey" },
              "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
            },
            "entryPacks": {
              "description": "With shardPacks: the index is packed into q/<n> files. The number of the first entry file in each entry pack, in pack order, starting with 0.",
              "type": "array",
              "items": { "$ref": "#/$defs/count" }
            },
            "shardPacks": {
              "description": "The first shard key, in ordinal order, of each shard pack; shard packs follow the entry packs.",
              "type": "array",
              "items": { "$ref": "#/$defs/shardKey" }
            }
          },
          "dependentRequired": { "entryPacks": ["shardPacks"], "shardPacks": ["entryPacks"] }
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["protocol", "type", "pages"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "pack" },
        "pages": {
          "description": "In a p/<n> pack, the children pages of many nodes, each as the JSON text of a page document; in a q/<n> pack, the search entry files or shards of an index, each as the JSON text of its document. A reader parses only the one it needs.",
          "type": "array",
          "items": { "type": "string", "minLength": 2, "contentMediaType": "application/json", "contentSchema": { "anyOf": [{ "$ref": "#/$defs/page" }, { "$ref": "#/$defs/searchEntries" }, { "$ref": "#/$defs/searchShard" }] } }
        }
      }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "shardKey": {
      "description": "A prefix of at least two encoded code units, with a trailing - for the word exactly that long, or one encoded code unit and - for a one-unit word; numbered parts append .2, .3, and so on.",
      "type": "string",
      "pattern": "^(?:(?:[a-z0-9]|_[0-9a-f]{4}){2,}-?|(?:[a-z0-9]|_[0-9a-f]{4})-)(\\.(?:[2-9]|[1-9][0-9]+))?$"
    },
    "searchShard": {
      "type": "object",
      "required": ["protocol", "type", "key", "words", "postings"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "searchShard" },
        "key": { "$ref": "#/$defs/shardKey" },
        "words": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "postings": {
          "description": "One list per word. A list starts with an entry number; after it a positive value is the gap to the next entry and a negative value -n stands for the n entries that follow without a gap.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "$ref": "#/$defs/count" }],
            "items": { "type": "integer", "minimum": -2147483647, "maximum": 2147483647, "not": { "const": 0 } }
          }
        }
      }
    },
    "searchEntry": {
      "description": "[parent entry number or -1, leading code units shared with the parent id, id part, trailing code units shared with the parent id, label, kind number or null, reference of the first children page when it is in another file than the page that holds the node, or null; reference of the page that holds the node when it is in another file than the first page of its list]; trailing nulls are left out.",
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "prefixItems": [
        { "type": "integer", "minimum": -1, "maximum": 2147483647 },
        { "$ref": "#/$defs/count" },
        { "type": "string" },
        { "$ref": "#/$defs/count" },
        { "type": "string" },
        { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
        { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        { "$ref": "#/$defs/identifier" }
      ]
    },
    "searchEntries": {
      "type": "object",
      "required": ["protocol", "type", "first", "stem", "entries"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "searchEntries" },
        "first": { "$ref": "#/$defs/count" },
        "stem": {
          "description": "The ancestors of the first entry from the top level down, each as its entry number followed by the fields of an entry.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 9,
            "prefixItems": [
              { "$ref": "#/$defs/count" },
              { "type": "integer", "minimum": -1, "maximum": 2147483647 },
              { "$ref": "#/$defs/count" },
              { "type": "string" },
              { "$ref": "#/$defs/count" },
              { "type": "string" },
              { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
              { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
              { "$ref": "#/$defs/identifier" }
            ]
          }
        },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/searchEntry" } }
      }
    }
  }
}
