{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/CanopyX/main/docs/schema/canopyx-flow-1.schema.json",
  "title": "CanopyX flow document, version 1",
  "description": "The flow contract of docs/flow.md: a guided form with steps, typed fields, conditions and a review page. The schema lists every field and rejects unknown ones, so it doubles as a writer check. Rules across the document (unique ids, condition references, values that fit their field and options, path conflicts) are checked by CanopyFlow.Validate and the browser reader.",
  "type": "object",
  "required": ["kind", "version", "id", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "flow" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "title": { "$ref": "#/$defs/shortText" },
    "description": { "$ref": "#/$defs/longText" },
    "mode": { "enum": ["linear", "free", "tasks"], "description": "Default linear. tasks opens on a task list." },
    "layout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "orientation": { "enum": ["auto", "horizontal", "vertical"], "description": "Default auto." },
        "container": { "enum": ["inline", "dialog", "drawer"], "description": "Default inline." },
        "launch": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S", "description": "The launch button of a dialog or drawer flow." }
      }
    },
    "density": { "enum": ["compact", "normal", "comfortable"], "description": "Default normal." },
    "timeZone": { "enum": ["utc", "local"], "description": "Default utc." },
    "steps": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/step" } },
    "initial": {
      "type": "object", "description": "Edit mode: the edited values by field id. Never a secret field.",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "storedSecrets": { "type": "array", "uniqueItems": true, "maxItems": 1000, "items": { "$ref": "#/$defs/identifier" }, "description": "Ids of secret fields with a stored value. Never the values." },
    "baseline": { "type": "string", "minLength": 1, "maxLength": 256 },
    "submit": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" } } },
    "labels": {
      "type": "object", "description": "Translations of the flow labels (flow…) and the shared field messages (gridEdit…).",
      "propertyNames": { "pattern": "^(flow[A-Z][A-Za-z0-9]*|gridEdit(Required|Number|Date|Min|Max|Step|MinLength|MaxLength|Pattern|Choice|NoMatches|Searching|None))$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "command": {
      "type": "object", "required": ["name"], "additionalProperties": false, "description": "The equivalent command the review page shows.",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f]*\\S[^\\u0000-\\u001f]*$" },
        "style": { "enum": ["powershell", "posix", "windows"], "description": "Default powershell." },
        "variants": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["id", "label"], "additionalProperties": false,
          "properties": { "id": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" } } } }
      }
    },
    "presets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/preset" } },
    "draft": { "enum": ["none", "session", "local", "host"], "description": "Default none." },
    "deepLinks": { "type": "boolean" },
    "endpoint": {
      "type": "object", "required": ["url", "routes"], "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/(?!/)[A-Za-z0-9_./~%-]*$" },
        "routes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["options", "fields", "check", "validate", "preview", "status", "draft", "submit"] } }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "longText": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "scalar": { "oneOf": [{ "type": "string", "maxLength": 4096 }, { "type": "number" }, { "type": "boolean" }] },
    "value": {
      "description": "A field value: text, a number, true or false, a list of them, rows of a records field, picked records, or null for empty.",
      "oneOf": [
        { "type": "null" }, { "type": "string" }, { "type": "number" }, { "type": "boolean" },
        { "type": "array", "maxItems": 1000, "items": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" },
          { "type": "object", "additionalProperties": { "oneOf": [{ "type": "null" }, { "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }] } }
      ]
    },
    "picked": {
      "type": "array", "maxItems": 1000, "description": "Records a pick step chose.",
      "items": { "type": "object", "required": ["id", "label"], "additionalProperties": false,
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "label": { "type": "string", "maxLength": 400 } } }
    },
    "recordColumn": {
      "type": "object", "required": ["id", "title"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/shortText" },
        "type": { "enum": ["text", "number", "date", "time", "select", "toggle"], "description": "Default text." },
        "required": { "type": "boolean" },
        "width": { "type": "integer", "minimum": 60, "maximum": 480 },
        "options": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/option" } },
        "validation": { "type": "object", "additionalProperties": false, "properties": {
          "min": { "type": "number" }, "max": { "type": "number" }, "minLength": { "type": "integer", "minimum": 0 }, "maxLength": { "type": "integer", "minimum": 0 },
          "pattern": { "type": "string", "minLength": 1, "maxLength": 256 }, "message": { "type": "string", "minLength": 1, "maxLength": 1024 } } }
      },
      "allOf": [{ "if": { "required": ["type"], "properties": { "type": { "const": "select" } } }, "then": { "required": ["options"] }, "else": { "not": { "required": ["options"] } } }]
    },
    "check": {
      "type": "object", "required": ["id", "label", "fields"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "fields": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "required": { "enum": ["pass", "run"] }
      }
    },
    "pick": {
      "type": "object", "required": ["field", "view", "label"], "additionalProperties": false,
      "properties": {
        "field": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": {
          "id": { "$ref": "#/$defs/identifier" }, "label": { "$ref": "#/$defs/shortText" }, "help": { "$ref": "#/$defs/longText" }, "required": { "type": "boolean" },
          "when": { "$ref": "#/$defs/condition" }, "parameter": { "$ref": "#/$defs/identifier" }, "path": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
          "sensitive": { "type": "boolean" }, "default": { "$ref": "#/$defs/picked" },
          "validation": { "type": "object", "additionalProperties": false, "properties": {
            "minItems": { "type": "integer", "minimum": 0, "maximum": 1000 }, "maxItems": { "type": "integer", "minimum": 0, "maximum": 1000 }, "message": { "type": "string", "minLength": 1, "maxLength": 1024 } } } } },
        "view": { "type": "object", "required": ["protocol", "type"], "description": "A grid (type grid) or tree (type view) document of docs/schema/canopyx-2.schema.json.",
          "properties": { "protocol": { "const": "canopyx/2" }, "type": { "enum": ["grid", "view"] } } },
        "label": { "type": "string", "minLength": 1, "description": "The view column whose text labels a picked record." },
        "tray": { "type": "boolean", "description": "Default true." },
        "height": { "type": "integer", "minimum": 160, "maximum": 1200 }
      }
    },
    "preset": {
      "type": "object", "required": ["id", "label", "values"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "values": { "type": "object", "propertyNames": { "$ref": "#/$defs/identifier" }, "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/value" }, { "$ref": "#/$defs/picked" }] } }
      }
    },
    "isoDuration": { "type": "string", "pattern": "^P(?=[0-9T])([0-9]{1,9}D)?(T(?=[0-9])([0-9]{1,9}H)?([0-9]{1,9}M)?([0-9]{1,9}S)?)?$" },
    "isoMoment": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,7})?)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "condition": {
      "description": "A condition group in the filter builder's grammar: at most eight levels, 64 groups and 64 predicates.",
      "type": "object", "required": ["operator"], "additionalProperties": false,
      "properties": {
        "operator": { "enum": ["and", "or", "none"] },
        "filters": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/predicate" } },
        "groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/condition" } }
      },
      "anyOf": [
        { "required": ["filters"], "properties": { "filters": { "minItems": 1 } } },
        { "required": ["groups"], "properties": { "groups": { "minItems": 1 } } }
      ]
    },
    "predicate": {
      "type": "object", "required": ["field", "operator"], "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "ne", "gt", "ge", "lt", "le", "contains", "notContains", "startsWith", "endsWith", "matches", "notMatches", "in", "notIn", "between", "isNull", "isNotNull"] },
        "values": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/scalar" } }
      },
      "allOf": [
        { "if": { "properties": { "operator": { "enum": ["isNull", "isNotNull"] } } }, "then": { "properties": { "values": { "maxItems": 0 } } } },
        { "if": { "properties": { "operator": { "enum": ["in", "notIn"] } } }, "then": { "required": ["values"], "properties": { "values": { "minItems": 1 } } } },
        { "if": { "properties": { "operator": { "const": "between" } } }, "then": { "required": ["values"], "properties": { "values": { "minItems": 2, "maxItems": 2 } } } },
        { "if": { "properties": { "operator": { "enum": ["eq", "ne", "gt", "ge", "lt", "le", "contains", "notContains", "startsWith", "endsWith", "matches", "notMatches"] } } },
          "then": { "required": ["values"], "properties": { "values": { "minItems": 1, "maxItems": 1 } } } },
        { "if": { "properties": { "operator": { "enum": ["startsWith", "endsWith", "matches", "notMatches"] } } }, "then": { "properties": { "values": { "items": { "type": "string" } } } } }
      ]
    },
    "option": {
      "type": "object", "required": ["value"], "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/scalar" },
        "label": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "badge": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "disabledReason": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S" },
        "group": { "$ref": "#/$defs/shortText" }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "min": { "oneOf": [{ "type": "number" }, { "type": "string" }], "description": "A number (number), an ISO moment (datetime) or an ISO duration (duration)." },
        "max": { "oneOf": [{ "type": "number" }, { "type": "string" }], "description": "As min." },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "minItems": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxItems": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "item": { "enum": ["email", "host", "ip", "cidr", "url"] },
        "itemPattern": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "field": {
      "type": "object", "required": ["id", "type", "label"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["text", "number", "date", "datetime", "time", "select", "toggle", "lookup", "choice", "multiChoice", "textarea", "list", "secret", "duration", "records", "custom"] },
        "editor": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" },
        "help": { "$ref": "#/$defs/longText" },
        "placeholder": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "default": { "$ref": "#/$defs/value" },
        "width": { "enum": ["full", "half"] },
        "parameter": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
        "when": { "$ref": "#/$defs/condition" },
        "options": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/option" } },
        "display": { "enum": ["cards", "list"] },
        "onText": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
        "offText": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
        "rows": { "type": "integer", "minimum": 2, "maximum": 20 },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "keepWhenBlank": { "type": "boolean" },
        "reveal": { "type": "boolean" },
        "units": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["seconds", "minutes", "hours", "days"] } },
        "validation": { "$ref": "#/$defs/validation" },
        "source": { "enum": ["document", "host"], "description": "Select, choice, multiple-choice and lookup fields: host takes the options from the host. Default document." },
        "dependsOn": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "columns": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/recordColumn" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "custom" } } }, "then": { "required": ["editor"] }, "else": { "not": { "required": ["editor"] } } },
        { "if": { "properties": { "type": { "enum": ["select", "choice", "multiChoice", "lookup"] } }, "not": { "required": ["source"], "properties": { "source": { "const": "host" } } } }, "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } } },
        { "if": { "properties": { "type": { "not": { "enum": ["select", "choice", "multiChoice", "lookup"] } } } }, "then": { "not": { "required": ["source"] } } },
        { "if": { "properties": { "type": { "const": "records" } } }, "then": { "required": ["columns"] }, "else": { "not": { "required": ["columns"] } } },
        { "if": { "properties": { "type": { "not": { "enum": ["select", "choice", "multiChoice", "lookup"] } } } }, "then": { "not": { "required": ["options"] } } },
        { "if": { "properties": { "type": { "not": { "const": "choice" } } } }, "then": { "not": { "required": ["display"] } } },
        { "if": { "properties": { "type": { "not": { "const": "toggle" } } } }, "then": { "not": { "anyOf": [{ "required": ["onText"] }, { "required": ["offText"] }] } } },
        { "if": { "properties": { "type": { "not": { "const": "textarea" } } } }, "then": { "not": { "required": ["rows"] } } },
        { "if": { "properties": { "type": { "not": { "const": "number" } } } }, "then": { "not": { "required": ["step"] } } },
        { "if": { "properties": { "type": { "not": { "const": "secret" } } } }, "then": { "not": { "anyOf": [{ "required": ["keepWhenBlank"] }, { "required": ["reveal"] }] } } },
        { "if": { "properties": { "type": { "const": "secret" } } }, "then": { "not": { "required": ["default"] } } },
        { "if": { "properties": { "type": { "not": { "const": "duration" } } } }, "then": { "not": { "required": ["units"] } } },
        { "if": { "properties": { "type": { "not": { "enum": ["text", "number", "lookup", "textarea", "list"] } } } }, "then": { "not": { "required": ["placeholder"] } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "validation": { "properties": { "min": { "type": "number" }, "max": { "type": "number" } } } } } },
        { "if": { "properties": { "type": { "const": "datetime" } } }, "then": { "properties": { "validation": { "properties": { "min": { "$ref": "#/$defs/isoMoment" }, "max": { "$ref": "#/$defs/isoMoment" } } } } } },
        { "if": { "properties": { "type": { "const": "duration" } } }, "then": { "properties": { "default": { "$ref": "#/$defs/isoDuration" }, "validation": { "properties": { "min": { "$ref": "#/$defs/isoDuration" }, "max": { "$ref": "#/$defs/isoDuration" } } } } } },
        { "if": { "properties": { "type": { "not": { "enum": ["number", "datetime", "duration"] } } } }, "then": { "properties": { "validation": { "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }] } } } } },
        { "if": { "properties": { "type": { "not": { "enum": ["text", "textarea", "secret"] } } } }, "then": { "properties": { "validation": { "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }, { "required": ["pattern"] }] } } } } },
        { "if": { "properties": { "type": { "not": { "enum": ["multiChoice", "list", "records"] } } } }, "then": { "properties": { "validation": { "not": { "anyOf": [{ "required": ["minItems"] }, { "required": ["maxItems"] }] } } } } },
        { "if": { "properties": { "type": { "not": { "const": "list" } } } }, "then": { "properties": { "validation": { "not": { "anyOf": [{ "required": ["item"] }, { "required": ["itemPattern"] }] } } } } },
        { "if": { "properties": { "type": { "const": "date" } } }, "then": { "properties": { "default": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } } },
        { "if": { "properties": { "type": { "const": "time" } } }, "then": { "properties": { "default": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } } },
        { "if": { "properties": { "type": { "const": "datetime" } } }, "then": { "properties": { "default": { "$ref": "#/$defs/isoMoment" } } } },
        { "if": { "properties": { "type": { "const": "toggle" } } }, "then": { "properties": { "default": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "default": { "type": "number" } } } },
        { "if": { "properties": { "type": { "enum": ["text", "textarea"] } } }, "then": { "properties": { "default": { "type": "string" } } } },
        { "if": { "properties": { "type": { "enum": ["multiChoice", "list", "records"] } } }, "then": { "properties": { "default": { "type": "array" } } } }
      ]
    },
    "section": {
      "type": "object", "required": ["id", "label"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "when": { "$ref": "#/$defs/condition" },
        "fields": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/field" } },
        "source": { "const": "host", "description": "The host supplies the section's fields; it has none of its own." },
        "dependsOn": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      },
      "if": { "required": ["source"] },
      "then": { "properties": { "fields": { "maxItems": 0 } } },
      "else": { "required": ["fields"], "not": { "required": ["dependsOn"] } }
    },
    "step": {
      "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["form", "info", "pick", "review"], "description": "Default form." },
        "title": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/longText" },
        "optional": { "type": "boolean" },
        "when": { "$ref": "#/$defs/condition" },
        "fields": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/field" } },
        "sections": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/section" } },
        "declaration": { "$ref": "#/$defs/longText" },
        "changesOnly": { "type": "boolean" },
        "checks": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/check" } },
        "group": { "$ref": "#/$defs/shortText" },
        "pick": { "$ref": "#/$defs/pick" },
        "confirm": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": {
          "label": { "$ref": "#/$defs/shortText" }, "text": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }, "field": { "$ref": "#/$defs/identifier" } },
          "oneOf": [{ "required": ["text"] }, { "required": ["field"] }] },
        "preview": { "type": "boolean", "description": "Review steps: the page shows the host's preview, so it carries the preview part." },
        "acknowledge": { "type": "object", "required": ["label"], "additionalProperties": false, "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "\\S" }, "when": { "$ref": "#/$defs/condition" } } }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "review" } } },
          "then": { "not": { "anyOf": [{ "required": ["fields"] }, { "required": ["sections"] }, { "required": ["when"] }, { "required": ["optional"] }, { "required": ["group"] }] } },
          "else": { "required": ["title"], "not": { "anyOf": [{ "required": ["declaration"] }, { "required": ["changesOnly"] }, { "required": ["confirm"] }, { "required": ["acknowledge"] }, { "required": ["preview"] }] } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "enum": ["info", "pick"] } } },
          "then": { "not": { "anyOf": [{ "required": ["fields"] }, { "required": ["sections"] }, { "required": ["checks"] }] } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "pick" } } },
