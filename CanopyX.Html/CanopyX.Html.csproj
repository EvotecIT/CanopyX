<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <EnableTrimAnalyzer Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</EnableAotAnalyzer>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>CanopyX.Html</PackageId>
    <Version>$(CanopyXProductVersion)</Version>
    <Authors>Evotec</Authors>
    <Description>Self-contained tree and flat-grid browser runtimes with virtual rows, typed query controls, saved views, scoped exports, host data sources, and theme CSS, plus page, fragment, tree bundle, and asset writers.</Description>
    <PackageReleaseNotes>Virtual tree and flat grids, typed query controls, saved views, scoped CSV and clipboard exports, host-governed Office exports and details, and page, fragment, bundle, and asset writers.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>tree-grid;treegrid;treeview;data-grid;virtualization;lazy-loading;data-views;html;javascript;reports;zero-dependency;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/EvotecIT/CanopyX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EvotecIT/CanopyX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) Evotec</Copyright>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanopyX\CanopyX.csproj" />
    <Compile Include="..\CanopyX\Bundles\PortableFolderNames.cs" Link="Shared\PortableFolderNames.cs" />
    <Compile Include="..\CanopyX\Bundles\BundlePaths.cs" Link="Shared\BundlePaths.cs" />
    <Compile Include="..\CanopyX\Bundles\BundleIdentity.cs" Link="Shared\BundleIdentity.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.nuget.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every runtime entry point, every part of Build/parts.json and the part manifest; the label packs ship as .NET factories. -->
    <EmbeddedResource Include="Assets\canopyx.js;Assets\canopyx.css;Assets\canopyx-*.js;Assets\canopyx-*.css;Assets\canopyx-parts.json" Exclude="Assets\canopyx-labels-*.js" LogicalName="CanopyX.Html.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\page.html" LogicalName="CanopyX.Html.Assets.page.html" />
  </ItemGroup>
</Project>
