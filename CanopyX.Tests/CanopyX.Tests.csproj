<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanopyX\CanopyX.csproj" />
    <ProjectReference Include="..\CanopyX.Html\CanopyX.Html.csproj" />
    <ProjectReference Include="..\CanopyX.Data\CanopyX.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\docs\schema\canopyx-2.schema.json" Link="Schema\canopyx-2.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tests\fixtures\search-folding.json" Link="Fixtures\search-folding.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CanopyX\Views\Locales\labels.json" Link="Fixtures\labels.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The search benchmark trees double as the index size fixture, so the test and the benchmark measure the same trees. -->
    <Compile Include="..\CanopyX.Examples\SearchBenchTrees.cs" Link="Bundles\SearchBenchTrees.cs" />
  </ItemGroup>
</Project>
