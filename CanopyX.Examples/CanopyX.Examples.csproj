  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates\index.html" LogicalName="CanopyX.Examples.Templates.index.html" />
    <EmbeddedResource Include="Templates\outline.html" LogicalName="CanopyX.Examples.Templates.outline.html" />
    <EmbeddedResource Include="Templates\outline-page.html" LogicalName="CanopyX.Examples.Templates.outline-page.html" />
    <EmbeddedResource Include="Templates\filter-bar.html" LogicalName="CanopyX.Examples.Templates.filter-bar.html" />
    <EmbeddedResource Include="Templates\live-records.html" LogicalName="CanopyX.Examples.Templates.live-records.html" />
    <EmbeddedResource Include="Templates\query-records.html" LogicalName="CanopyX.Examples.Templates.query-records.html" />
    <EmbeddedResource Include="Templates\long-document.html" LogicalName="CanopyX.Examples.Templates.long-document.html" />
    <EmbeddedResource Include="Templates\checkboxes.html" LogicalName="CanopyX.Examples.Templates.checkboxes.html" />
    <EmbeddedResource Include="Templates\interactions.html" LogicalName="CanopyX.Examples.Templates.interactions.html" />
    <EmbeddedResource Include="Templates\contained-grids.html" LogicalName="CanopyX.Examples.Templates.contained-grids.html" />
    <EmbeddedResource Include="Templates\column-layout.html" LogicalName="CanopyX.Examples.Templates.column-layout.html" />
    <EmbeddedResource Include="Templates\tree-parity.html" LogicalName="CanopyX.Examples.Templates.tree-parity.html" />
    <EmbeddedResource Include="Templates\linked-views.html" LogicalName="CanopyX.Examples.Templates.linked-views.html" />
  </ItemGroup>
</Project>
