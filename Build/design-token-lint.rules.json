{
  "schemaVersion": 1,
  "description": "Shared component CSS literal rules. Consumers may implement the scanner in their existing runtime.",
  "include": [
    "HtmlForgeX/Resources/Styles/hfx-*.css",
    "HtmlForgeX/Resources/Styles/ThemeSource/*.css"
  ],
  "exclude": [
    "hfx-tokens.css",
    "hfx-theme.css"
  ],
  "generatedMarkers": {
    "begin": "/* hfx-token-fallbacks:begin */",
    "end": "/* hfx-token-fallbacks:end */"
  },
  "layoutAllowance": "lint-allow layout:",
  "colorFunctions": "(?i)\\b(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)\\(",
  "hexColor": "(?i)#[0-9a-f]{3,8}\\b",
  "length": "(?i)(?<![\\w-])-?(?:\\d*\\.)?\\d+(?:px|r?em|ex|cap|ic|lh|rlh|v[wh]|vmin|vmax|[sld]v[wh]|pt|pc|in|cm|mm|q)\\b",
  "systemColors": [
    "AccentColor",
    "AccentColorText",
    "ActiveText",
    "ButtonBorder",
    "ButtonFace",
    "ButtonText",
    "Canvas",
    "CanvasText",
    "Field",
    "FieldText",
    "GrayText",
    "Highlight",
    "HighlightText",
    "LinkText",
    "Mark",
    "MarkText",
    "SelectedItem",
    "SelectedItemText",
    "VisitedText"
  ],
