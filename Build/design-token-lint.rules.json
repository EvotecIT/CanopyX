  "rules": [
    {
      "id": "color",
      "properties": "^.*$",
      "check": "color"
    },
    {
      "id": "radius",
      "properties": "^(?:border(?:-(?:top|bottom)-(?:left|right)|-(?:start|end)-(?:start|end))?-radius|--[\\w-]*radius(?:-[\\w-]+)?)$",
      "check": "radius"
    },
    {
      "id": "type",
      "properties": "^(?:font(?:-size|-family|-weight)?|line-height|--[\\w-]*(?:font-size|font-family|font-weight|line-height|font-(?:sans|display|mono)))$",
      "check": "type"
    },
    {
      "id": "spacing",
      "properties": "^(?:(?:padding|margin|inset)(?:-[a-z-]+)?|(?:row-|column-)?gap|top|right|bottom|left)$",
      "check": "length"
    },
    {
      "id": "border",
      "properties": "^(?:border(?:-(?:top|right|bottom|left|block|inline)(?:-(?:start|end))?)?(?:-width)?|outline(?:-width|-offset)?)$",
      "check": "length"
    },
    {
      "id": "shadow",
      "properties": "^(?:box|text)-shadow$",
      "check": "shadow"
    },
    {
      "id": "z-index",
      "properties": "^z-index$",
      "check": "number"
    },
    {
      "id": "size",
      "properties": "^(?:(?:min-|max-)?(?:width|height|inline-size|block-size)|flex-basis|--[\\w-]+)$",
      "check": "size"
    },
    {
      "id": "fallback",
      "properties": "^.*$",
      "check": "fallback"
    }
  ]
}
