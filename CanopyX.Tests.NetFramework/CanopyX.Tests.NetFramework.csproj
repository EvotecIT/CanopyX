<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the framework-sensitive contract tests against the net472 build of CanopyX, whose platform text data differs
    from .NET. It builds everywhere but runs only on Windows, where .NET Framework is available.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(OS)' == 'Windows_NT'">true</IsTestProject>
    <IsTestProject Condition="'$(OS)' != 'Windows_NT'">false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanopyX\CanopyX.csproj" />
    <ProjectReference Include="..\CanopyX.Html\CanopyX.Html.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CanopyX.Tests\Bundles\SearchFoldingParityTests.cs" Link="Bundles\SearchFoldingParityTests.cs" />
    <Compile Include="..\CanopyX.Tests\Protocol\StreamedViewJsonTests.cs" Link="Protocol\StreamedViewJsonTests.cs" />
    <Compile Include="..\CanopyX.Tests\Rendering\StaticGridResultTests.cs" Link="Rendering\StaticGridResultTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\GridFormattingEvaluationTests.cs" Link="Grids\GridFormattingEvaluationTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\GridNumberRoundingTests.cs" Link="Grids\GridNumberRoundingTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\GridColumnGroupTests.cs" Link="Grids\GridColumnGroupTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\TypedGridTests.cs" Link="Grids\TypedGridTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\TypedCalendarTests.cs" Link="Grids\TypedCalendarTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\CalendarEventsTests.cs" Link="Grids\CalendarEventsTests.cs" />
    <Compile Include="..\CanopyX.Tests\Calendar\ICalendarTests.cs" Link="Calendar\ICalendarTests.cs" />
    <Compile Include="..\CanopyX.Tests\Records\RecordFrameworkTests.cs" Link="Records\RecordFrameworkTests.cs" />
    <Compile Include="..\CanopyX.Tests\Recurrence\RecurrenceFixture.cs" Link="Recurrence\RecurrenceFixture.cs" />
    <Compile Include="..\CanopyX.Tests\Recurrence\RecurrenceFixtureTests.cs" Link="Recurrence\RecurrenceFixtureTests.cs" />
    <Compile Include="..\CanopyX.Tests\Recurrence\RecurrenceTests.cs" Link="Recurrence\RecurrenceTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\TypedConversionTests.cs" Link="Grids\TypedConversionTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\GridDetailWriterTests.cs" Link="Grids\GridDetailWriterTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\GridColumnCapabilityTests.cs" Link="Grids\GridColumnCapabilityTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\EditingMomentBoundsTests.cs" Link="Grids\EditingMomentBoundsTests.cs" />
    <Compile Include="..\CanopyX.Tests\Records\TimelineDepthTests.cs" Link="Records\TimelineDepthTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\RecordDetailWriterTests.cs" Link="Grids\RecordDetailWriterTests.cs" />
    <Compile Include="..\CanopyX.Tests\Grids\NestedDetailFixture.cs" Link="Grids\NestedDetailFixture.cs" />
    <Compile Include="..\CanopyX.Tests\Records\CollectionDepthTests.cs" Link="Records\CollectionDepthTests.cs" />
    <Compile Include="..\CanopyX.Tests\Html\RecordTreeCollectionAssetsTests.cs" Link="Html\RecordTreeCollectionAssetsTests.cs" />
    <None Include="..\tests\fixtures\search-folding.json" Link="Fixtures\search-folding.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tests\fixtures\recurrence-cases.json" Link="Fixtures\recurrence-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
