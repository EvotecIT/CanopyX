<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A generic fleet inventory served from SQLite through EF Core, shown in a CanopyX grid in remote mode. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>FleetInventory</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CanopyX.Html\CanopyX.Html.csproj" />
    <ProjectReference Include="..\..\CanopyX.AspNetCore\CanopyX.AspNetCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>
</Project>
