{
  "name": "canopyx-browser-tests",
  "private": true,
  "type": "module",
  "description": "Browser tests and benchmarks for the CanopyX runtime. Not part of the library build.",
  "scripts": {
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:all": "node tools/browsers.mjs all",
    "test:firefox": "node tools/browsers.mjs firefox",
    "test:webkit": "node tools/browsers.mjs webkit",
    "test:visual": "node node_modules/@playwright/test/cli.js test --project=visual",
    "test:visual:update": "node node_modules/@playwright/test/cli.js test --project=visual --update-snapshots",
    "test:distribution": "node tools/distribution-smoke.mjs",
    "bench": "node bench/scroll-benchmark.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2"
  }
}
