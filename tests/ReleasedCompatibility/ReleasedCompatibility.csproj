<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CanopyX.Released032.Host</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the host against the released binaries. Tests supply the current runtime assemblies. -->
    <PackageReference Include="CanopyX" Version="[0.3.2]" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CanopyX.Data" Version="[0.3.2]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
