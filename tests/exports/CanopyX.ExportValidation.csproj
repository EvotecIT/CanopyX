<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Independent artifact readers and schema validation only; no shipped project references this executable. -->
    <PackageReference Include="OfficeIMO.Excel" Version="3.5.2" PrivateAssets="all" />
    <PackageReference Include="OfficeIMO.Pdf" Version="3.5.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
