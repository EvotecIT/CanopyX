{
  "name": "@evotecit/canopyx",
  "version": "0.1.0",
  "description": "Dependency-free virtualized tree grid with lazy data, checking intent and host-governed interactions.",
  "type": "module",
  "license": "MIT",
  "types": "./JavaScript/index.d.ts",
  "exports": {
    ".": {
      "types": "./JavaScript/index.d.ts",
      "import": "./CanopyX.Html/Assets/canopyx-module.mjs"
    },
    "./styles.css": "./CanopyX.Html/Assets/canopyx-interactive.css",
    "./core.css": "./CanopyX.Html/Assets/canopyx.css",
    "./classic.js": "./CanopyX.Html/Assets/canopyx-interactive.js",
    "./core.js": "./CanopyX.Html/Assets/canopyx.js",
    "./grid": {
      "types": "./JavaScript/grid.d.ts",
      "import": "./CanopyX.Html/Assets/canopyx-grid-module.mjs"
    },
    "./grid.css": "./CanopyX.Html/Assets/canopyx-grid.css",
    "./grid.js": "./CanopyX.Html/Assets/canopyx-grid.js",
    "./reporting": {
      "types": "./JavaScript/grid.d.ts",
      "import": "./CanopyX.Html/Assets/canopyx-reporting-module.mjs"
    },
    "./reporting.css": "./CanopyX.Html/Assets/canopyx-reporting.css",
    "./reporting.js": "./CanopyX.Html/Assets/canopyx-reporting.js",
    "./locales/pl": { "types": "./JavaScript/locales/pl.d.ts", "import": "./JavaScript/locales/pl.mjs" },
    "./locales/de": { "types": "./JavaScript/locales/de.d.ts", "import": "./JavaScript/locales/de.mjs" },
    "./locales/es": { "types": "./JavaScript/locales/es.d.ts", "import": "./JavaScript/locales/es.mjs" },
    "./locales/pl.js": "./CanopyX.Html/Assets/canopyx-labels-pl.js",
    "./locales/de.js": "./CanopyX.Html/Assets/canopyx-labels-de.js",
    "./locales/es.js": "./CanopyX.Html/Assets/canopyx-labels-es.js"
  },
  "files": [
    "JavaScript/*.d.ts",
    "JavaScript/locales/*.d.ts",
    "JavaScript/locales/*.mjs",
    "CanopyX.Html/Assets/canopyx-labels-*.js",
    "CanopyX.Html/Assets/canopyx-module.mjs",
    "CanopyX.Html/Assets/canopyx-interactive.js",
    "CanopyX.Html/Assets/canopyx-interactive.css",
    "CanopyX.Html/Assets/canopyx.js",
    "CanopyX.Html/Assets/canopyx.css",
    "CanopyX.Html/Assets/canopyx-grid-module.mjs",
    "CanopyX.Html/Assets/canopyx-grid.js",
    "CanopyX.Html/Assets/canopyx-grid.css",
    "CanopyX.Html/Assets/canopyx-reporting-module.mjs",
    "CanopyX.Html/Assets/canopyx-reporting.js",
    "CanopyX.Html/Assets/canopyx-reporting.css"
  ],
  "keywords": ["treegrid", "treeview", "virtualization", "accessibility", "lazy-loading"],
  "engines": { "node": ">=18" }
}
